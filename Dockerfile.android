# Build environment for the companion app (android/): JDK, Android SDK and
# Gradle stay in this image, nothing on the host. Used locally
# (tools/android-docker.sh) and by GitHub Actions. Two stages: android
# (the app's) and link-android (the link's core for it); build one with
# --target.
FROM ubuntu:24.04 AS android

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-21-jdk-headless unzip curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Google's command-line tools, checked against the SHA-1 their repository
# lists (dl.google.com/android/repository/repository2-3.xml).
ENV ANDROID_HOME=/opt/android-sdk
ARG CMDLINE_TOOLS=commandlinetools-linux-16111833_latest.zip
ARG CMDLINE_TOOLS_SHA1=e025545c62a8e64c7559119566a569fb1dec5f60
RUN curl -fsSL -o /tmp/tools.zip "https://dl.google.com/android/repository/$CMDLINE_TOOLS" \
    && echo "$CMDLINE_TOOLS_SHA1  /tmp/tools.zip" | sha1sum -c - \
    && unzip -q /tmp/tools.zip -d /tmp/tools \
    && mkdir -p "$ANDROID_HOME/cmdline-tools" \
    && mv /tmp/tools/cmdline-tools "$ANDROID_HOME/cmdline-tools/latest" \
    && rm -rf /tmp/tools /tmp/tools.zip

# Building this image accepts the Android SDK license
# (https://developer.android.com/studio/terms), as the project owner did.
RUN yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null \
    && "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" \
        "platforms;android-36" "build-tools;36.0.0" > /dev/null

ARG GRADLE=9.8.2
ARG GRADLE_SHA256=21bd5da2de49b642904077f38c0efdc7778e92b3ed0889392dca61b97e389607
RUN curl -fsSL -o /tmp/gradle.zip "https://services.gradle.org/distributions/gradle-$GRADLE-bin.zip" \
    && echo "$GRADLE_SHA256  /tmp/gradle.zip" | sha256sum -c - \
    && unzip -q /tmp/gradle.zip -d /opt \
    && ln -s "/opt/gradle-$GRADLE/bin/gradle" /usr/local/bin/gradle \
    && rm /tmp/gradle.zip

# Gradle's caches live in a volume (see tools/android-docker.sh), and so
# does the debug signing key: a new one at every build would make Android
# refuse to update the installed app.
ENV GRADLE_USER_HOME=/gradle ANDROID_USER_HOME=/gradle/android
WORKDIR /src/android

# The link's core for the app (link/android, a JNI library): on top of the
# app's build image (the stage above), the NDK from Google's SDK manager
# (checked against its repository) and Rust with the Android target from
# rustup (its installer checked against the SHA-256 the release lists, the
# toolchain against the release's manifest). Used by tools/link-docker.sh
# android; nothing on the host. A stage of this file, not an image of its
# own: CI's builder sees the stage, never an image loaded beside it.
FROM android AS link-android

# The crates' build scripts run here, on the build machine: its C toolchain.
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

ARG NDK=29.0.14206865
RUN "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" "ndk;$NDK" > /dev/null
ENV ANDROID_NDK=$ANDROID_HOME/ndk/$NDK

ARG RUSTUP=1.28.2
ARG RUST=1.85.1
ENV RUSTUP_HOME=/opt/rustup
RUN url="https://static.rust-lang.org/rustup/archive/$RUSTUP/x86_64-unknown-linux-gnu/rustup-init" \
    && curl -fsSL -o /tmp/rustup-init "$url" \
    && want="$(curl -fsSL "$url.sha256" | cut -d' ' -f1)" \
    && echo "$want  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && CARGO_HOME=/opt/cargo /tmp/rustup-init -y --no-modify-path --profile minimal \
        --default-toolchain "$RUST" --target aarch64-linux-android \
    && rm /tmp/rustup-init

# The crates in the plus-one-cargo volume (as tools/link-docker.sh's), the
# NDK's clang as the linker and the C compiler (ring), for Android 13 on
# (the app's minSdk, 33).
ENV CARGO_HOME=/cargo PATH=/opt/cargo/bin:$PATH \
    CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER=$ANDROID_NDK/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android33-clang \
    CC_aarch64_linux_android=$ANDROID_NDK/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android33-clang \
    AR_aarch64_linux_android=$ANDROID_NDK/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar
WORKDIR /src/link
