#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    # Not in a chroot or an image being built: no modules, no devices there.
    if [ -d /run/systemd/system ] && ! ischroot 2>/dev/null; then
        # The S Pen's helper and its policy: D-Bus reads them again.
        dbus-send --system --type=method_call --dest=org.freedesktop.DBus / \
            org.freedesktop.DBus.ReloadConfig 2>/dev/null || true
        modprobe uhid 2>/dev/null || true
        # /dev/uhid is root's alone again: up to 0.5 a group had it (and up
        # to 0.4 whoever was logged in, through an ACL from a uaccess tag udev
        # keeps). Removed and added again, so that tag goes; group, mode and
        # ACL put back by hand (udev keeps what a rule once set).
        udevadm control --reload 2>/dev/null || true
        udevadm trigger --action=remove --subsystem-match=misc --sysname-match=uhid 2>/dev/null || true
        udevadm trigger --action=add --subsystem-match=misc --sysname-match=uhid 2>/dev/null || true
        udevadm settle 2>/dev/null || true
        if [ -e /dev/uhid ]; then
            chgrp root /dev/uhid 2>/dev/null || true
            chmod 600 /dev/uhid 2>/dev/null || true
            setfacl -b /dev/uhid 2>/dev/null || true
        fi
        # The camera's loopback device, if the kernel has the module (else
        # v4l2loopback-dkms brings it); Plus One says so in its window otherwise.
        modprobe v4l2loopback 2>/dev/null || true
    fi
    # The link's socket for every user, from their next login (Plus One
    # starts it in a session already open).
    if command -v deb-systemd-helper >/dev/null; then
        deb-systemd-helper --user enable plus-one-link.socket >/dev/null 2>&1 || true
    fi
    if [ -n "$2" ] && dpkg --compare-versions "$2" lt 0.6 && getent group plus-one >/dev/null; then
        echo "Plus One: the S Pen no longer needs the plus-one group (a helper makes it);"
        echo "    sudo groupdel plus-one    removes it, if nothing else of yours uses it."
    fi
fi
exit 0
