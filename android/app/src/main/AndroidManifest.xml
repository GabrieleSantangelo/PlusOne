<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WebRTC finds the networks to offer candidates on through these. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- mDNS, and what a "connected device" foreground service needs. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Updates the paired PC hands over: installed by the app, without a
         question once it is the app that installed itself (Updates.kt). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Wi-Fi without power saving while the PC uses the tablet (a Wi-Fi lock). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The camera and the microphone for the PC, when the user lets it have them. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- A Wi-Fi Direct group with the PC, a path of their own (P2pHandler):
         never used to tell where the tablet is. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Lets a PDF sent by the PC open by itself; granted by the user in Settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PlusOne"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One signing screen, in a task of its own (the queue's PDFs open
             in it), named after the PDF in Recents. A new theme (light or
             dark) recreates it; the PDF and what was drawn stay. -->
        <activity
            android:name=".SignActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.gabrielesantangelo.plusone.sign"
            android:theme="@style/Theme.PlusOne.Sign"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|fontScale|locale|layoutDirection" />

        <!-- The PC's desktop, on the whole screen, landscape as the PC's
             monitor is; opened by the service when the PC asks. -->
        <activity
            android:name=".DisplayActivity"
            android:exported="false"
            android:theme="@style/Theme.PlusOne.Sign"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.gabrielesantangelo.plusone.display"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density" />

        <activity
            android:name=".AllowActivity"
            android:exported="false"
            android:theme="@style/Theme.PlusOne.Capture"
            android:excludeFromRecents="true" />

        <activity
            android:name=".PairActivity"
            android:exported="false"
            android:theme="@style/Theme.PlusOne.Pair"
            android:excludeFromRecents="true" />

        <!-- See-through, for an instant: brings the app in front so its
             service may use the camera or the microphone for the PC. -->
        <activity
            android:name=".CaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.PlusOne.Capture"
            android:taskAffinity="io.github.gabrielesantangelo.plusone.capture"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <service
            android:name=".CompanionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|camera|microphone" />

        <receiver
            android:name=".PairingReceiver"
            android:exported="false" />

        <receiver
            android:name=".DisplayStopReceiver"
            android:exported="false" />

        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
