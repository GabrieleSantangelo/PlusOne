#!/usr/bin/python3 -P
"""Plus One's S Pen with pressure and tilt, for the session in front of the
PC. As root (D-Bus activated on the system bus), one virtual HID tablet per
caller on /dev/uhid, with the S Pen's own descriptor, fed only the pen's
reports, which the caller sends through a socket it gets from Open().
Polkit says who may: the active local session (the action below). The
pen goes as soon as that session is no longer the one in front (another
user's switched to, or it ended): its caller could go on sending, and the
other user's compositor would take the reports as clicks.

Not a /dev/uhid file descriptor handed out: its holder could destroy the
pen and create a keyboard on it. Through the socket only 10-byte pen
reports pass; anything else is dropped. The pen goes when the socket closes.

--session: on the session bus, as the user, no polkit (for trying it out:
then it can do only what the user could already)."""
import os
import socket
import struct
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

NAME = "io.github.gabrielesantangelo.PlusOne.Pen"
PATH = "/io/github/gabrielesantangelo/PlusOne/Pen"
ACTION = "io.github.gabrielesantangelo.plusone.pen"
DBUS = "org.freedesktop.DBus"
LOGIN1 = "org.freedesktop.login1"
MANAGER = "/org/freedesktop/login1"
SESSION = "org.freedesktop.login1.Session"
PROPERTIES = "org.freedesktop.DBus.Properties"
XML = f"""<node><interface name="{NAME}">
  <method name="Open"><arg name="reports" type="h" direction="out"/></method>
</interface></node>"""
UHID = "/dev/uhid"
UHID_DESTROY, UHID_CREATE2, UHID_INPUT2 = 1, 11, 12
BUS_VIRTUAL = 0x06
VENDOR, PRODUCT = 0x04E8, 0x5350  # as plusone/pen.py: GNOME maps it onto the virtual monitor by these
DEVICE_NAME = "Plus One S Pen"
REPORT_ID, REPORT_SIZE = 0x14, 10
# plusone/pen.py S_PEN: Digitizer / Pen / Stylus, nothing else.
S_PEN = bytes.fromhex(
    "050d0902a10185140920a10009420944093c0945093215002501750195058102950381030501"
    "093075109501a4550d65133500463a2027ff7f000081020931462c1827ff7f00008102b4050d"
    "093026001081027508093d15a6255a8102093e8102c0c0")
MAX_PENS = 4   # at once, all callers together
IDLE = 60      # seconds without a pen before the helper exits (activated again on demand)

pens = {}      # our end's fd -> Pen
loop = GLib.MainLoop()
idle_source = None


class Pen:
    def __init__(self, session=None):
        self.uhid = os.open(UHID, os.O_RDWR | os.O_CLOEXEC | os.O_NONBLOCK)
        try:
            os.write(self.uhid, struct.pack("<I128s64s64sHHIIII", UHID_CREATE2, DEVICE_NAME.encode(),
                                            b"plus-one", b"", len(S_PEN), BUS_VIRTUAL, VENDOR, PRODUCT, 1, 0)
                     + S_PEN)
        except OSError:
            os.close(self.uhid)
            raise
        self.ours, self.theirs = socket.socketpair(socket.AF_UNIX, socket.SOCK_SEQPACKET)
        self.ours.setblocking(False)
        self.watches = [
            GLib.io_add_watch(self.ours.fileno(), GLib.PRIORITY_HIGH,
                              GLib.IOCondition.IN | GLib.IOCondition.HUP | GLib.IOCondition.ERR, self._report),
            # The kernel's start/open notifications: read, or its queue fills.
            GLib.io_add_watch(self.uhid, GLib.PRIORITY_DEFAULT, GLib.IOCondition.IN, self._drain),
        ]
        self.session = session  # its caller's, watched while it lives (None: --session)
        pens[self.ours.fileno()] = self

    def _report(self, _fd, condition):
        if condition & (GLib.IOCondition.HUP | GLib.IOCondition.ERR):
            self.close()
            return False
        try:
            data = self.ours.recv(64)
        except BlockingIOError:
            return True
        except OSError:
            self.close()
            return False
        if not data:
            self.close()
            return False
        if len(data) == REPORT_SIZE and data[0] == REPORT_ID:  # the pen's, and only that
            try:
                os.write(self.uhid, struct.pack("<IH", UHID_INPUT2, len(data)) + data)
            except OSError:
                pass
        return True

    def _drain(self, _fd, _condition):
        try:
            os.read(self.uhid, 4380)
        except OSError:
            pass
        return True

    def close(self):
        if pens.pop(self.ours.fileno(), None) is None:
            return
        for watch in self.watches:
            GLib.source_remove(watch)
        if self.session is not None:
            self.session.release()
        try:
            os.write(self.uhid, struct.pack("<I", UHID_DESTROY))
        except OSError:
            pass
        os.close(self.uhid)
        self.ours.close()
        arm_idle()


def call(bus, name, path, interface, method, args, reply):
    return bus.call_sync(name, path, interface, method, args, GLib.VariantType(reply),
                         Gio.DBusCallFlags.NONE, 10000, None).unpack()


class Session:
    """The caller's logind session: its process's, else its user's graphical
    one, as polkit judges it (Plus One, a D-Bus service of its user's, is in
    no session of its own). Watched from before it is read, so a switch in
    between is not missed; logind's signals only, no timer."""

    def __init__(self, bus, sender):
        self.bus, self.ids = bus, []
        self.path = self._find(sender)
        if self.path is None:
            return
        self.ids = [bus.signal_subscribe(LOGIN1, PROPERTIES, "PropertiesChanged", self.path, SESSION,
                                         Gio.DBusSignalFlags.NONE, self._changed),
                    bus.signal_subscribe(LOGIN1, "org.freedesktop.login1.Manager", "SessionRemoved", MANAGER,
                                         None, Gio.DBusSignalFlags.NONE, self._removed)]

    def _find(self, sender):
        pid = call(self.bus, DBUS, "/org/freedesktop/DBus", DBUS, "GetConnectionUnixProcessID",
                   GLib.Variant("(s)", (sender,)), "(u)")[0]
        try:
            return call(self.bus, LOGIN1, MANAGER, "org.freedesktop.login1.Manager", "GetSessionByPID",
                        GLib.Variant("(u)", (pid,)), "(o)")[0]
        except GLib.Error:
            pass
        uid = call(self.bus, DBUS, "/org/freedesktop/DBus", DBUS, "GetConnectionUnixUser",
                   GLib.Variant("(s)", (sender,)), "(u)")[0]
        try:
            user = call(self.bus, LOGIN1, MANAGER, "org.freedesktop.login1.Manager", "GetUser",
                        GLib.Variant("(u)", (uid,)), "(o)")[0]
            _id, path = call(self.bus, LOGIN1, user, PROPERTIES, "Get",
                             GLib.Variant("(ss)", ("org.freedesktop.login1.User", "Display")), "(v)")[0]
        except GLib.Error:
            return None
        return None if path == "/" else path

    def in_front(self):
        """Active on a seat (one with none, over SSH, is always "active")."""
        if self.path is None:
            return False
        try:
            values = call(self.bus, LOGIN1, self.path, PROPERTIES, "GetAll", GLib.Variant("(s)", (SESSION,)),
                          "(a{sv})")[0]
            return bool(values["Active"]) and bool(values["Seat"][0])
        except (GLib.Error, KeyError):
            return False

    def _changed(self, _connection, _sender, _path, _interface, _signal, params):
        _session, values, invalidated = params.unpack()
        if values.get("Active") is False or ("Active" in invalidated and not self.in_front()):
            self._gone()

    def _removed(self, _connection, _sender, _path, _interface, _signal, params):
        if params.unpack()[1] == self.path:
            self._gone()

    def _gone(self):
        for pen in list(pens.values()):
            if pen.session is self:
                pen.close()

    def release(self):
        for subscription in self.ids:
            self.bus.signal_unsubscribe(subscription)
        self.ids = []


def authorized(bus, sender):
    if bus is None:
        return True  # --session: the user's own rights
    subject = ("system-bus-name", {"name": GLib.Variant("s", sender)})
    reply = bus.call_sync("org.freedesktop.PolicyKit1", "/org/freedesktop/PolicyKit1/Authority",
                          "org.freedesktop.PolicyKit1.Authority", "CheckAuthorization",
                          GLib.Variant("((sa{sv})sa{ss}us)", (subject, ACTION, {}, 0, "")),
                          GLib.VariantType("((bba{ss}))"), Gio.DBusCallFlags.NONE, 10000, None)
    return reply.unpack()[0][0]


def method_call(connection, sender, _path, _interface, method, _params, invocation, system_bus):
    if method != "Open":
        invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)
        return
    session = None
    try:
        if not authorized(system_bus, sender):
            invocation.return_dbus_error("org.freedesktop.DBus.Error.AccessDenied",
                                         "not the session in front of this PC")
            return
        if len(pens) >= MAX_PENS:
            invocation.return_dbus_error("org.freedesktop.DBus.Error.LimitsExceeded", "too many pens")
            return
        if system_bus is not None:
            session = Session(system_bus, sender)
            if not session.in_front():
                session.release()
                invocation.return_dbus_error("org.freedesktop.DBus.Error.AccessDenied",
                                             "not the session in front of this PC")
                return
        pen = Pen(session)
    except (GLib.Error, OSError) as e:
        if session is not None:
            session.release()
        invocation.return_dbus_error("org.freedesktop.DBus.Error.Failed", str(e))
        return
    fds = Gio.UnixFDList.new()
    fds.append(pen.theirs.fileno())
    pen.theirs.close()  # the list holds its own copy
    invocation.return_value_with_unix_fd_list(GLib.Variant("(h)", (0,)), fds)
    arm_idle()


def arm_idle():
    global idle_source
    if idle_source:
        GLib.source_remove(idle_source)
    idle_source = GLib.timeout_add_seconds(IDLE, lambda: (not pens and loop.quit()) or True)


def main():
    session = "--session" in sys.argv[1:]
    bus_type = Gio.BusType.SESSION if session else Gio.BusType.SYSTEM
    interface = Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0]

    def acquired(connection, _name):
        system_bus = None if session else connection
        connection.register_object(PATH, interface,
                                   lambda *a: method_call(*a, system_bus), None, None)

    Gio.bus_own_name(bus_type, NAME, Gio.BusNameOwnerFlags.NONE, acquired, None, lambda *a: loop.quit())
    arm_idle()
    loop.run()
    for pen in list(pens.values()):
        pen.close()


if __name__ == "__main__":
    main()
