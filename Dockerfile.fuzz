# The link's fuzzing (link/fuzz, cargo-fuzz): libFuzzer's instrumentation
# needs a nightly Rust, pinned, from rustup checked as Dockerfile.android
# checks it. Used by tools/fuzz-docker.sh.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG RUSTUP=1.28.2
ARG NIGHTLY=nightly-2026-09-15
ARG CARGO_FUZZ=0.13.2
ENV RUSTUP_HOME=/opt/rustup
RUN url="https://static.rust-lang.org/rustup/archive/$RUSTUP/x86_64-unknown-linux-gnu/rustup-init" \
    && curl -fsSL -o /tmp/rustup-init "$url" \
    && want="$(curl -fsSL "$url.sha256" | cut -d' ' -f1)" \
    && echo "$want  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && CARGO_HOME=/opt/cargo /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "$NIGHTLY" \
    && rm /tmp/rustup-init \
    && CARGO_HOME=/opt/cargo /opt/cargo/bin/cargo install cargo-fuzz --version "$CARGO_FUZZ" --locked

# The crates in the plus-one-cargo volume, as tools/link-docker.sh's.
ENV CARGO_HOME=/cargo PATH=/opt/cargo/bin:$PATH
WORKDIR /src/link
